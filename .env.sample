# Embedding 配置
EMBEDDING_API_KEY=YOUR_API_KEY
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 长期记忆配置
#MEMORY_BASE_PATH=

# 情景记忆提取（重要：此处请选择OpenAI的模型，否则可能出现json生成错误）
EPISODIC_EXTRACTION_MODEL=gpt-5.4
EPISODIC_EXTRACTION_BASE_URL=https://www.dmxapi.cn/v1
EPISODIC_EXTRACTION_API_KEY=YOUR_API_KEY

# Mem0 语义记忆提取（重要：此处请选择OpenAI的模型，否则可能出现json生成错误）
MEM0_EXTRACTION_MODEL=gpt-5.4
MEM0_EXTRACTION_BASE_URL=https://www.dmxapi.cn/v1
MEM0_EXTRACTION_API_KEY=YOUR_API_KEY

# Tavily 配置
TAVILY_API_KEY=YOUR_API_KEY

# VLM配置
VLM_API_KEY=YOUR_API_KEY
VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VLM_MODEL=qwen3-vl-plus

# Electron 默认自行生成临时 Token 并管理后端，以下配置仅供开发覆盖。
# AYAYA_MANAGE_BACKEND=false
# AYAYA_API_TOKEN=外部后端模式下显式提供的至少43字符临时Token
# AYAYA_PYTHON_EXECUTABLE=C:/path/to/ayaya/python.exe
# AYAYA_BACKEND_CWD=C:/path/to/Ayaya
# AYAYA_BACKEND_BASE_URL=http://127.0.0.1:8000
